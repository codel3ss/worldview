# ---------------------------------------------------------------------------
# worldview environment
#
# Everything here is OPTIONAL. With an empty .env the app still boots and runs
# every zero-key layer (aircraft, satellites, earthquakes, launches, bikeshare,
# radio) on an OpenStreetMap-textured globe.
#
# Legend:  free = free signup   metered = you are billed per use
# ---------------------------------------------------------------------------

# --- Browser-exposed (VITE_ prefixed keys are compiled into the bundle) ------

# metered - Google Photorealistic 3D Tiles. Without it the globe falls back to
# flat OSM imagery. RESTRICT THIS KEY BY HTTP REFERRER AND SET A BUDGET ALERT.
# https://developers.google.com/maps/documentation/tile/get-api-key
VITE_GOOGLE_MAPS_API_KEY=

# free tier - unlocks Cesium World Terrain (real elevation) and Bing imagery.
# https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# --- Server-side only (brokered by server/index.js, never sent to the browser)

# free - NASA FIRMS active fire detections. https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# free - AISStream live vessel positions. https://aisstream.io/
AISSTREAM_API_KEY=

# free tier - TomTom traffic flow. https://developer.tomtom.com/
TOMTOM_API_KEY=

# free tier - OpenSky Network OAuth2 client credentials (raises poll quota).
# The aircraft layer works anonymously without these.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Ports -----------------------------------------------------------------
PORT_WEB=4173
PORT_PROXY=8787
PROXY_ORIGIN=http://127.0.0.1:8787
